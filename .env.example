# ENEM Essay Correction API - Environment Variables
# Copy to .env and fill in your values

# Groq API Key (FREE - get from https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: NVIDIA NIM API Key (backup - FREE from https://build.nvidia.com)
# NVIDIA_API_KEY=nvapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: HuggingFace Token (for higher rate limits on dataset downloads)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Model Selection (Groq free tier models)
GROQ_TEXT_MODEL=llama-3.1-70b-instant
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# RAG Settings
CHROMA_PERSIST_DIR=./chroma_db
FEW_SHOTS_PATH=./data/few_shots/few_shots.json
GUIDELINES_DIR=./data/matriz
